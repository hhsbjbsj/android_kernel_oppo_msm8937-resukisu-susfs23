# OPPO A57 (16061, MSM8937 / Snapdragon 435) - 4.19 config fragment

# Machine selection
CONFIG_ARCH_MSM8937=y
CONFIG_MACH_OPPO=y
CONFIG_MACH_OPPO_MSM8940=y
CONFIG_MACH_16061=y
CONFIG_OPPO_DEVICE_INFO=y

# Touchscreen (Goodix GT5688)
CONFIG_TOUCHPANEL_OPPO=y
CONFIG_TOUCHPANEL_GOODIX=y
CONFIG_TOUCHPANEL_GOODIX_GT5688=y

# Power and Charger
CONFIG_QPNP_FG=y
CONFIG_QPNP_SMBCHARGER=y

# Input and Haptics
CONFIG_INPUT_QTI_HAPTICS=y
CONFIG_LEDS_VIBRATOR_GPIO=y
CONFIG_INPUT_FPC1020=y

# Storage and File Systems
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_FRAGMENT_CACHE_SIZE=3

# NLS
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Debug and Logging
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_LZ4_COMPRESS=y

# Display and Backlight
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_LCD_CLASS_DEVICE=y
CONFIG_LEDS_QPNP_WLED=y

# Security
CONFIG_SECURITY_DMESG_RESTRICT=y
